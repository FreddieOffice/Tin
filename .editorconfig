# EditorConfig is awesome: https://editorconfig.org

root = true

[*]
charset = utf-8
end_of_line = lf
indent_size = 4
intent_style = space
insert_final_newline = true
trim_trailing_whitespace = true

[{*.{yml,yaml},.clang{-format,-tidy}}]
indent_size = 2

[*.bat]
end_of_line = crlf

[*.md]
trim_trailing_whitespace = false

[**/Vendor/**]
indent_size = unset
indent_style = unset
trim_trailing_whitespace = unset
